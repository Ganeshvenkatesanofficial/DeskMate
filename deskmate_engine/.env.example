# DeskMate engine settings (all optional)

# Where Ollama listens for local chat models.
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Default Ollama chat model when the app doesn't pick one.
# OLLAMA_CHAT_MODEL=qwen3:4b

# Gemini key for cloud chat (the app usually sends its own).
# GEMINI_API_KEY=

# Engine port (the app normally chooses it).
# PORT=2026
